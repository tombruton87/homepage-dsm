# What the setup container writes to .env beside compose.yaml.
HTTP_PORT=3010
LAN_IP=192.168.1.10
TZ=Europe/London
APP_URL=http://192.168.1.10:3010
SSL_PROXY=0
HP_IMAGE=ghcr.io/gethomepage/homepage:latest
ALLOWED_HOSTS=192.168.1.10:3010      # kept in step with the address by the package
DSM_USER=""                          # optional: a DSM account for the Synology stats widget
DSM_PASS=""
DSM_VOLUME=                          # e.g. volume_1 (empty: all)
# The dashboard itself (hidden tiles, your links, title, theme) is in .dashboard.json.
